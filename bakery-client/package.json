    "check:all": "pnpm check && pnpm check:diff && pnpm check:transcript && pnpm check:handle && pnpm check:panestate && pnpm check:sessions && pnpm check:studio && pnpm check:terminal && pnpm check:busy && pnpm check:reviewfocus && pnpm check:keyedrefresh && pnpm check:studiotriggers && pnpm check:taskreviewcompare && pnpm check:taskagentlabel && pnpm check:react && pnpm check:panelstate && pnpm check:livesnapshot && pnpm check:pageshown && pnpm check:events && pnpm check:panelcommands && pnpm check:claudeproviders && pnpm check:effortpicks && pnpm check:composerkeys && pnpm check:agentmap && pnpm check:bakerthreads && pnpm check:conversations && pnpm check:theme && pnpm check:adapterpin && pnpm check:apiclient && pnpm check:layout && pnpm check:containers && pnpm check:unifieddiff && pnpm check:review && pnpm check:floor && pnpm check:sidebar && pnpm check:code && pnpm check:states && pnpm check:phases && pnpm check:github && pnpm check:hosts && pnpm check:machineaccess && pnpm check:saved && pnpm check:cache && pnpm check:views && pnpm check:tweakcn && pnpm check:visual && pnpm check:electron",
