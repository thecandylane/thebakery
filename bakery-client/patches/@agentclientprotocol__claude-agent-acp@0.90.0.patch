+/** Bakery: Claude Code's Ultracode (standing dynamic workflows at any effort)
+ *  as the session toggle Claude Code's own editors show. The CLI's
+ *  get_settings says whether the session can take it (`ultracodeAvailable`)
+ *  and whether it is on (`ultracodeRequested`). */
+const BAKERY_ULTRACODE_CONFIG_ID = "ultracode";
+function bakeryUltracodeOption(on) {
+    return {
+        id: BAKERY_ULTRACODE_CONFIG_ID,
+        name: "Ultracode",
+        description: "Dynamic workflows on every task, this session only",
+        category: "model_config",
+        type: "boolean",
+        currentValue: on,
+    };
+}
+/** `{ available, on }` from the CLI, or undefined when it did not answer. */
+async function bakeryReadUltracode(query, logger) {
+    let timer;
+    try {
+        const settings = await Promise.race([
+            query.getSettings(),
+            new Promise((_, reject) => {
+                timer = setTimeout(() => reject(new Error("get_settings took over 5 s")), 5000);
+            }),
+        ]);
+        const applied = settings?.applied;
+        return { available: applied?.ultracodeAvailable === true, on: applied?.ultracodeRequested === true };
+    }
+    catch (error) {
+        logger.error("Failed to read the session's ultracode state:", error);
+        return undefined;
+    }
+    finally {
+        clearTimeout(timer);
+    }
+}
+/** An effort change sent without the `ultracode` key turns ultracode off
+ *  (CLI 2.1.284+), so every effort apply carries it while it is on. */
+function bakeryKeepUltracode(session) {
+    return session.bakeryUltracode?.on ? { ultracode: true } : {};
