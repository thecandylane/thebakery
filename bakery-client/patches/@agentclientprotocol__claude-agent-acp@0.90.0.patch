 import { applyClaudePermissionSelection, parseClaudePermissionSelection } from "./effects.js";
+const BAKERY_REVIEWED_PATH = { Edit: "file_path", Write: "file_path", NotebookEdit: "notebook_path" };
+function bakeryReview(response, toolName, input, toolUseID, selection) {
+    const review = response?._meta?.["bakery.dev/review"];
+    if (review === undefined)
+        return { input };
+    const pathKey = BAKERY_REVIEWED_PATH[toolName];
+    if (!pathKey ||
+        !review ||
+        typeof review !== "object" ||
+        Array.isArray(review) ||
+        review.version !== 1 ||
+        review.toolCallId !== toolUseID) {
+        throw new Error("Invalid Bakery Review permission response");
+    }
+    // A refusal carries the Bakery's reason, which Claude reads in place of
+    // the generic one.
+    if (selection.optionId === "reject") {
+        if (typeof review.reason !== "string" || !review.reason)
+            throw new Error("Bakery Review refusal omitted its reason");
+        return { input, reason: review.reason };
+    }
+    if (selection.optionId !== "allow-once" ||
+        !review.updatedInput ||
+        typeof review.updatedInput !== "object" ||
+        Array.isArray(review.updatedInput)) {
+        throw new Error("Invalid Bakery Review permission response");
+    }
+    const updated = review.updatedInput;
+    if (typeof input[pathKey] !== "string" || updated[pathKey] !== input[pathKey]) {
+        throw new Error(`Bakery Review cannot change a tool's ${pathKey}`);
+    }
+    if (toolName === "Write") {
+        if (typeof updated.content !== "string")
+            throw new Error("Bakery Review Write response omitted content");
+    }
+    else if (toolName === "NotebookEdit") {
+        if (typeof updated.new_source !== "string")
+            throw new Error("Bakery Review NotebookEdit response omitted new_source");
+    }
+    else if (typeof updated.old_string !== "string" || typeof updated.new_string !== "string") {
+        throw new Error("Bakery Review Edit response omitted an edit range");
+    }
+    return { input: updated };
+}
