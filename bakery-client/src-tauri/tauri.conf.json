{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bakery-client",
  "version": "0.1.0",
  "identifier": "io.github.thecandylane.bakery",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBundleCommand": "node ../scripts/stage-claude-native.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bakery",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      ".runtime/claude-native": "claude-native"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
